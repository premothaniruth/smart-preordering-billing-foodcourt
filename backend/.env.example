# Backend environment configuration for Smart Preordering & Billing
# Copy this file to .env and replace placeholder values before running in production.

### Core service configuration
PORT=3001
JWT_SECRET=change-me
RUN_SERVER=true

### Admin console fallback credentials (override in production)
ADMIN_USERNAME=infybhojans
ADMIN_PASSWORD=infybhojans

### External integrations
REDIS_URL=redis://127.0.0.1:6379
ANALYTICS_STREAM=analytics.events
ANALYTICS_STREAM_MAX_LEN=25000
ANALYTICS_CONSUMER_GROUP=analytics-ingestors
ANALYTICS_CONSUMER_NAME=analytics-worker
ANALYTICS_EVENT_APP=smart-foodcourt-backend
ENABLE_ANALYTICS_INGESTOR=true
ANALYTICS_INGESTOR_BATCH_SIZE=100
ANALYTICS_INGESTOR_BLOCK_MS=5000
ANALYTICS_INGESTOR_RETRY_MS=3000
DUCKDB_PATH=./data/analytics.duckdb
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=change-me
INFLUX_ORG=smart-foodcourt
INFLUX_BUCKET=vendor_metrics

### Import/export controls
ANALYTICS_IMPORT_MAX_SIZE=15728640
IMPORT_EMIT_RETRY_ATTEMPTS=3
IMPORT_EMIT_RETRY_BASE_MS=250
AUDIT_LOG_MAX_BYTES=5242880

### Forecasting & procurement tuning
FORECAST_LOOKBACK_DAYS=14
FORECAST_WINDOW_DAYS=7
FORECAST_SAFETY_STOCK_DAYS=2
FORECAST_HORIZON_DAYS=7
FORECAST_FEATURE_WINDOW_DAYS=60
FORECAST_EVAL_WINDOW_DAYS=7
FORECAST_MAPE_ALERT_THRESHOLD=0.25
FORECAST_EVAL_CRON=30 2 * * *
NIGHTLY_ARCHIVE_CRON=0 2 * * *
POINTS_REMINDER_CRON=0 5 * * *
POINTS_EXPIRY_CRON=30 5 * * *
PROCUREMENT_LEAD_TIME_DAYS=2
PROCUREMENT_SAFETY_DAYS=1.5

### Offer & wallet policies
OFFERS_MAX_DISCOUNT=0

### Authentication providers
APPLE_CLIENT_ID=
